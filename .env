# =============================================================================
# ENVIRONMENT
# =============================================================================
# Set to 'production' for AWS deployment, 'development' for local
ENVIRONMENT=production

# =============================================================================
# AWS S3 CONFIGURATION (required for production)
# =============================================================================
# S3 bucket containing the data files
AWS_S3_BUCKET=pharmacy-deserts-data

# AWS region for S3 bucket
AWS_REGION=us-east-1

# AWS credentials (optional if using IAM roles on EC2)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Set to 'true' to require password authentication
REQUIRE_AUTH=true

# Password for app access (required if REQUIRE_AUTH=true)
APP_PASSWORD=MckessonPharmacies

# =============================================================================
# DATA PATHS (relative paths, will be prefixed with S3 bucket in production)
# =============================================================================
DATA_DIR=raw_data
RESULTS_DIR=results

# =============================================================================
# STREAMLIT SETTINGS
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0


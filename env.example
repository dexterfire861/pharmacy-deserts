# Pharmacy Desert Explorer - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Set to 'production' for AWS deployment, 'development' for local
ENVIRONMENT=development

# =============================================================================
# AWS S3 CONFIGURATION (required for production)
# =============================================================================
# S3 bucket containing the data files
AWS_S3_BUCKET=pharmacy-deserts-data

# AWS region for S3 bucket
AWS_REGION=us-east-1

# AWS credentials (optional if using IAM roles on EC2)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Set to 'true' to require password authentication
REQUIRE_AUTH=false

# Password for app access (required if REQUIRE_AUTH=true)
APP_PASSWORD=your-secure-password-here

# =============================================================================
# DATA PATHS (relative paths, will be prefixed with S3 bucket in production)
# =============================================================================
DATA_DIR=raw_data
RESULTS_DIR=results

# =============================================================================
# DATASET CONFIGURATION
# =============================================================================
# Optional: Load data from a configured dataset instead of default files
# When set, the app will load from raw_data/datasets/{ACTIVE_DATASET_ID}/
# instead of the default raw_data/ files
# ACTIVE_DATASET_ID=my_custom_dataset

# =============================================================================
# STREAMLIT SETTINGS
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0

